# CourtListener ++ MCP Server - Environment Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# API Configuration
# =============================================================================

# GovInfo API Key (required for statute lookup tools)
# Get your API key from: https://api.data.gov/signup/ (works for api.govinfo.gov)
GOVINFO_API_KEY=

# Regulations.gov API Key (required for federal rulemaking document tools)
# Get your API key from: https://api.data.gov/signup/ (works for api.regulations.gov)
# If missing at startup, the regulations_* tools are auto-disabled until set.
REGULATIONS_API_KEY=

# CourtListener API Key (optional - some endpoints work without authentication)
# Get your API key from: https://www.courtlistener.com/help/api/rest/#authentication
COURT_LISTENER_API_KEY=

# CourtListener API Base URL (default: https://www.courtlistener.com/api/rest/v4/)
COURTLISTENER_BASE_URL=https://www.courtlistener.com/api/rest/v4/

# API Request Timeout in seconds (default: 30)
COURTLISTENER_TIMEOUT=30

# =============================================================================
# Server Configuration
# =============================================================================

# Server Host (default: 0.0.0.0 - listens on all interfaces)
HOST=0.0.0.0

# MCP Server Port (default: 8785)
MCP_PORT=8785

# =============================================================================
# Environment Settings
# =============================================================================

# Environment: production or development (default: production)
ENVIRONMENT=production

# =============================================================================
# Logging Configuration
# =============================================================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
COURTLISTENER_LOG_LEVEL=INFO

# Enable Debug Mode: true or false (default: false)
COURTLISTENER_DEBUG=false

# =============================================================================
# Optional: Rate Limiting (if implemented)
# =============================================================================

# Rate Limit: Number of requests allowed per period (default: 10)
# RATE_LIMIT_REQUESTS=10

# Rate Limit Period in seconds (default: 60)
# RATE_LIMIT_PERIOD=60

# =============================================================================
# Optional: FastMCP HTTP Deployment Knobs
# =============================================================================

# Stateless HTTP mode for multiple replicas behind a load balancer
# (streamable HTTP sessions are per-instance; pair with FASTMCP_DOCKET_URL)
# FASTMCP_STATELESS_HTTP=false

# Persistent tasks backend URL for horizontal scaling, e.g. redis://localhost:6379/0
# FASTMCP_DOCKET_URL=

# Host/origin protection for public HTTP deployments (default: disabled)
# FASTMCP_HTTP_HOST_ORIGIN_PROTECTION=false
# FASTMCP_HTTP_ALLOWED_HOSTS=
# FASTMCP_HTTP_ALLOWED_ORIGINS=
